# Copy to deploy/.env.cloud, then fill actual values on the server.
CLOUD_DOMAIN=navguide.example.org
ACME_EMAIL=operator@example.org
# Generate a new token with python -c "import secrets; print(secrets.token_urlsafe(48))".
NAVGUIDE_GATEWAY_TOKEN=
DASHSCOPE_API_KEY=
# Use the endpoint for the same region and workspace as the API key.
DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OMNI_MODEL=qwen-omni-turbo
QWEN_TEXT_MODEL=qwen-turbo
CLOUD_TIMEOUT_SECONDS=30
CLOUD_MAX_REQUEST_BYTES=8388608
CLOUD_MAX_CONCURRENT_REQUESTS=4
CLOUD_MAX_OUTPUT_TOKENS=1024

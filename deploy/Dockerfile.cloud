FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-cloud.txt /app/requirements-cloud.txt
COPY constraints.txt /app/constraints.txt
RUN pip install --no-cache-dir -r requirements-cloud.txt -c constraints.txt && useradd --uid 10001 --create-home gateway
COPY navguide /app/navguide
USER gateway
EXPOSE 8090
CMD ["uvicorn", "navguide.cloud.gateway:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1", "--no-access-log", "--limit-concurrency", "32", "--timeout-keep-alive", "5"]

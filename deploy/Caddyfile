    email {$ACME_EMAIL}
}

{$CLOUD_DOMAIN} {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        -Server
    }
    reverse_proxy gateway:8090 {
        flush_interval -1
        transport http {
            dial_timeout 5s
            response_header_timeout 35s
        }
    }
}

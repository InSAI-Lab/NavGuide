# Local reference service. No model or cloud credential needed for observations.
NAVGUIDE_HOST=127.0.0.1
NAVGUIDE_PORT=8081
NAVGUIDE_DEVICE_TOKEN=
NAVGUIDE_FRONTEND=observations
NAVGUIDE_UDP_ENABLED=false
NAVGUIDE_UDP_HOST=127.0.0.1
NAVGUIDE_UDP_PORT=12345
NAVGUIDE_IMU_TIMEOUT_SECONDS=0.5
NAVGUIDE_OBSERVATION_TIMEOUT_SECONDS=1.5
NAVGUIDE_MAX_FRAME_BYTES=2097152
NAVGUIDE_MAX_FRAME_PIXELS=12582912
NAVGUIDE_SPEECH_ENABLED=false
NAVGUIDE_SPEECH_COMMAND=espeak-ng
NAVGUIDE_SPEECH_VOICE=cmn
YOLOE_MODEL_PATH=model/yoloe-11l-seg.pt
# NAVGUIDE_DEVICE=cuda:0
# BLIND_PATH_MODEL=model/yolo-seg.pt
# TRAFFIC_LIGHT_MODEL=model/trafficlight.pt
# ITEM_SEARCH_MODEL=model/shoppingbest5.pt
# HAND_TASK_PATH=model/hand_landmarker.task
NAVGUIDE_CLOUD_ENABLED=false
NAVGUIDE_CLOUD_URL=
NAVGUIDE_CLOUD_TOKEN=
DASHSCOPE_API_KEY=
DASHSCOPE_COMPAT_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_OMNI_MODEL=qwen-omni-turbo
QWEN_TEXT_MODEL=qwen-turbo
CLOUD_TIMEOUT_SECONDS=30
# Optional microphone recognition uses DashScope directly, not the gateway.
NAVGUIDE_ASR_ENABLED=false
ASR_MODEL=paraformer-realtime-v2
DASHSCOPE_ASR_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
ASR_CONNECT_TIMEOUT_SECONDS=10
ASR_MAX_SESSION_SECONDS=60
# Extended navigation recording. Disabled by default.
NAVGUIDE_RECORDING_ENABLED=false
